PORT=8085
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/<database_name>
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=1d

# Razorpay credentials (get from https://dashboard.razorpay.com)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Frontend URL (for CORS and cookies)
# In development: http://localhost:5173
# In production on Render: https://<your-frontend-service-name>.onrender.com
CLIENT_URL=http://localhost:5173

# Node Environment
NODE_ENV=development
